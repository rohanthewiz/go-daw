// go-daw mixer stylesheet (Stylus source, compiled by go-styl at startup).
// Dark studio theme: near-black chassis, panel strips, green/amber/red meters.

bg = #16181d
panel = #21242c
panel2 = #2a2e38
line = #383d4a
ink = #cdd3e0
inkDim = #7d8496
accent = #4da3ff
green = #37c66a
amber = #e8c05a

*
  box-sizing border-box

body
  margin 0
  background bg
  color ink
  font 12px/1.4 -apple-system, "Helvetica Neue", sans-serif
  user-select none

// ---- transport bar ----
.transport
  display flex
  align-items center
  gap 10px
  padding 8px 14px
  background panel2
  border-bottom 1px solid line
  position sticky
  top 0
  z-index 10

.brand
  font-weight 700
  letter-spacing 1px
  color accent
  margin-right 6px

.rec-btn
  background #3a2026
  color #ff5d6c
  border 1px solid #63323c
  border-radius 4px
  padding 4px 10px
  cursor pointer
  &[data-on="1"]
    background #c0263a
    color #fff
    animation recblink 1s infinite

@keyframes recblink
  50%
    opacity 0.55

.rec-time
  min-width 52px
  color #ff8d99
  font-variant-numeric tabular-nums

.scene-box
  display flex
  gap 6px
  margin-left auto

.badge.warn
  background #4a3b16
  color #e8c05a
  border-radius 3px
  padding 2px 8px

.conn-dot
  color #555
  &[data-live="1"]
    color green

// ---- metronome ----
.metro-box
  display flex
  align-items center
  gap 6px
  select
    background panel2
    color ink
    border 1px solid line
    border-radius 3px

.metro-btn
  background panel2
  color inkDim
  border 1px solid line
  border-radius 4px
  padding 4px 10px
  cursor pointer
  &[data-on="1"]
    background #4a3b16
    color amber
    border-color #6b5620
  // Beat flash, two strengths mirroring the accent/plain click sounds.
  // These rules sit after data-on so a running metronome's flash wins.
  &[data-beat="1"]
    background amber
    color #16181d
  &[data-beat="2"]
    background #6b5620
    color #f5e6bd

#metro-bpm
  width 56px
  background panel2
  color ink
  border 1px solid line
  border-radius 3px
  padding 3px 4px
  font inherit

.metro-label
  color inkDim
  font-size 10px
  margin-left -2px

// ---- console layout ----
.console
  display flex
  gap 14px
  padding 14px
  align-items flex-start

.channels
  display flex
  gap 8px
  overflow-x auto
  flex 1

.buses
  display flex
  gap 8px

// ---- strips ----
.strip
  background panel
  border 1px solid line
  border-radius 6px
  padding 8px
  width 168px
  flex-shrink 0
  display flex
  flex-direction column
  gap 6px

.strip-group
  background #232833

.strip-master
  background #2b2430
  border-color #4a3f55

.strip-name
  font-weight 700
  text-align center
  padding 2px 0
  border-bottom 1px solid line

.limiter-note
  text-align center
  color inkDim
  font-size 10px

// ---- sections ----
.sect
  background panel2
  border-radius 4px
  padding 3px 6px
  > summary
    cursor pointer
    color inkDim
    font-weight 600
    font-size 11px
    text-transform uppercase
    letter-spacing 0.5px

.eq-band
  border-top 1px dashed line
  padding-top 3px
  margin-top 3px

.eq-band-head
  color accent
  font-size 10px
  font-weight 700

// ---- controls ----
.ctl
  display flex
  align-items center
  gap 5px
  margin 3px 0
  label
    width 44px
    color inkDim
    font-size 10px
    flex-shrink 0
  input[type="range"]
    flex 1
    min-width 0
    accent-color accent
    height 14px
  .readout
    width 40px
    text-align right
    font-size 10px
    color ink
    font-variant-numeric tabular-nums
    flex-shrink 0

.toggle
  display inline-flex
  align-items center
  gap 4px
  color inkDim
  font-size 10px
  input
    accent-color green

// ---- source & routing ----
.src-row, .route-row
  display flex
  align-items center
  gap 5px
  label
    color inkDim
    font-size 10px
  select
    flex 1
    background panel2
    color ink
    border 1px solid line
    border-radius 3px

.src-osc, .src-synth, .src-sfont, .src-midi, .src-wav
  display none
  &[data-visible="1"]
    display block

// Bank + instrument selects stack vertically: GM program names are long, and
// a full-width row keeps them readable inside a narrow strip.
.src-sfont, .src-midi
  select
    display block
    width 100%
    margin-bottom 3px
    background panel2
    color ink
    border 1px solid line
    border-radius 3px
    font-size 10px

// Transport row: compact square buttons plus the position readout. The play
// button doubles as the state indicator (data-state set from the SSE stream).
.midi-transport
  display flex
  align-items center
  gap 3px
  margin 2px 0 4px
  button
    background panel2
    color ink
    border 1px solid line
    border-radius 3px
    font-size 11px
    line-height 1
    padding 3px 6px
    cursor pointer
    &:hover
      background panel
  button[data-state="playing"]
    background #1f4630
    border-color green
  button[data-state="paused"]
    background #4a3f1f
    border-color amber
  .midi-pos
    margin-left auto
    color inkDim
    font-size 10px
    font-variant-numeric tabular-nums

.src-wav
  input[type="text"]
    width 100%
    background panel2
    border 1px solid line
    color ink
    border-radius 3px
    padding 2px 4px

// ---- modules ----
.mod
  border 1px solid line
  border-radius 4px
  padding 3px 5px
  margin 4px 0
  background panel

.mod-head
  display flex
  justify-content space-between
  font-weight 600
  color accent

.mod-remove
  background none
  border none
  color #ff5d6c
  cursor pointer
  font-size 13px

.mod-add select
  width 100%
  background panel2
  color ink
  border 1px solid line
  border-radius 3px

// ---- mute ----
.mute-btn
  background panel2
  color inkDim
  border 1px solid line
  border-radius 4px
  padding 3px 0
  cursor pointer
  font-weight 700
  &[data-on="1"]
    background #b3435c
    color #fff

// ---- fader & meter ----
.fader-row
  display flex
  justify-content center
  gap 10px
  padding-top 4px

.fader-wrap
  display flex
  flex-direction column
  align-items center
  gap 4px

input.fader
  writing-mode vertical-lr
  direction rtl
  width 28px
  height 170px
  accent-color accent

.fader-readout
  width auto

.meter
  position relative
  width 14px
  height 170px
  background #101216
  border 1px solid line
  border-radius 3px
  overflow hidden

.meter-rms
  position absolute
  bottom 0
  left 0
  right 0
  height 0
  background linear-gradient(to top, green 0%, green 60%, #e8c05a 82%, #ff5d6c 100%)
  background-size 100% 170px
  background-position bottom

.meter-peak
  position absolute
  left 0
  right 0
  bottom 0
  height 2px
  background #fff
  opacity 0.85

// ---- virtual piano ----
.piano
  margin 0 14px 14px
  background panel
  border 1px solid line
  border-radius 6px
  padding 8px 10px

.piano-head
  display flex
  align-items center
  gap 8px
  margin-bottom 8px
  label
    color inkDim
    font-size 10px
  select
    background panel2
    color ink
    border 1px solid line
    border-radius 3px
  button
    background panel2
    color ink
    border 1px solid line
    border-radius 3px
    padding 2px 8px
    cursor pointer

.piano-title
  font-weight 700
  color accent
  text-transform uppercase
  letter-spacing 0.5px
  font-size 11px

.piano-oct
  min-width 26px
  text-align center
  font-variant-numeric tabular-nums

.piano-hint
  margin-left auto
  color inkDim
  font-size 10px

// Web MIDI device picker in the piano header. The dot mirrors .conn-dot:
// grey = no device, green = bound, red = browser denied MIDI access.
.midi-box
  display inline-flex
  align-items center
  gap 4px

.midi-dot
  color #555
  &[data-live="1"]
    color green
  &[data-live="err"]
    color #ff8d99

.piano-keys
  position relative
  display flex
  height 120px
  // Blocks browser touch gestures (scroll/zoom) so pointer events reach keys.
  touch-action none

.piano-key
  border-radius 0 0 4px 4px
  cursor pointer
  display flex
  align-items flex-end
  justify-content center
  padding-bottom 4px

.piano-key.white
  flex 1
  background #e8eaf0
  border 1px solid #9aa0ad
  border-top none
  color #6a7080
  &[data-on="1"]
    background accent
    color #fff

.piano-key.black
  position absolute
  top 0
  height 62%
  background #14161b
  border 1px solid #000
  z-index 2
  color #7d8496
  &[data-on="1"]
    background accent
    color #fff

.key-hint
  font-size 9px
  text-transform uppercase
  pointer-events none

// ---- piano tutorial ----
// Key cues: the guide ring is amber so it stays readable under both idle key
// colors and the accent-blue pressed fill (ring + fill can show together); a
// miss flashes the struck key red. The miss rules sit after the .white/.black
// blocks so they win the specificity tie against [data-on].
.piano-key[data-guide="1"]
  box-shadow inset 0 0 0 3px amber

.piano-key.white[data-miss="1"]
  background #d24856
  color #fff

.piano-key.black[data-miss="1"]
  background #d24856
  color #fff

.tutorial
  margin 0 14px 14px
  background panel
  border 1px solid line
  border-radius 6px
  padding 8px 10px

.tut-head
  display flex
  align-items center
  gap 8px
  select
    background panel2
    color ink
    border 1px solid line
    border-radius 3px
  button
    background panel2
    color ink
    border 1px solid line
    border-radius 3px
    padding 2px 8px
    cursor pointer

.tut-title
  font-weight 700
  color amber
  text-transform uppercase
  letter-spacing 0.5px
  font-size 11px

// Count-in toggle: label wraps the checkbox so the text is a click target too.
.tut-countin
  display flex
  align-items center
  gap 4px
  color inkDim
  font-size 10px
  cursor pointer
  user-select none

.tut-progress
  font-variant-numeric tabular-nums
  color ink

.tut-msg
  margin-left auto
  color inkDim
  font-size 10px

// One chip per lesson step; long tunes scroll horizontally rather than wrap
// so the strip reads left-to-right like a score.
.tut-strip
  display flex
  gap 4px
  margin-top 8px
  overflow-x auto
  padding-bottom 2px

.tut-chip
  flex-shrink 0
  padding 2px 8px
  background panel2
  border 1px solid line
  border-radius 10px
  font-size 10px
  color inkDim
  &[data-done="1"]
    color green
    border-color green
  &[data-cur="1"]
    background amber
    border-color amber
    color #16181d

// ---- getting-started tour ----
// The dim is one element's outward box-shadow rather than a full-screen
// scrim: a 9999px spread darkens everything around the ring while the ring
// itself stays pointer-events none, so the spotlit control is still clickable
// and the tour's "try it now" tips are honest. Only the balloon takes input.
.tour-btn
  background #2c3446
  color accent
  border 1px solid #3d4a66
  border-radius 4px
  padding 4px 10px
  cursor pointer
  &:hover
    background #34405a

.tour
  display none
  &[data-open="1"]
    display block

.tour-ring
  position fixed
  z-index 100
  border 2px solid amber
  border-radius 6px
  pointer-events none
  box-shadow 0 0 0 9999px rgba(9, 10, 14, 0.68)
  // Only the box geometry animates, so the spotlight glides from control to
  // control instead of teleporting; scroll-driven repositioning lands on the
  // same numbers and stays still.
  transition left 0.18s ease, top 0.18s ease, width 0.18s ease, height 0.18s ease
  // Targetless steps (the welcome and closing cards) park a zero-size ring
  // mid-viewport: the page still dims, but no border box floats in the middle.
  &[data-on="0"]
    border-color transparent

.tour-balloon
  position fixed
  z-index 101
  width 330px
  background panel2
  border 1px solid #6b5620
  border-radius 8px
  padding 10px 12px
  box-shadow 0 12px 34px rgba(0, 0, 0, 0.55)

.tour-head
  display flex
  align-items center
  gap 8px
  margin-bottom 5px

.tour-section
  color amber
  font-size 10px
  font-weight 700
  text-transform uppercase
  letter-spacing 0.5px

.tour-count
  color inkDim
  font-size 10px
  font-variant-numeric tabular-nums

.tour-close
  margin-left auto
  background none
  border none
  color inkDim
  font-size 16px
  line-height 1
  cursor pointer
  padding 0 2px
  &:hover
    color ink

.tour-title
  font-size 14px
  font-weight 700
  color ink
  margin-bottom 4px

.tour-body
  color ink
  line-height 1.55

// The "try this" line reads as an aside, not as more body copy.
.tour-tip
  display none
  margin-top 7px
  padding 5px 8px
  background #2f2a1c
  border-left 2px solid amber
  border-radius 0 3px 3px 0
  color #e6dcc0
  font-size 11px
  line-height 1.45
  &[data-on="1"]
    display block

.tour-foot
  display flex
  flex-wrap wrap
  align-items center
  gap 6px
  margin-top 10px
  // Direct children only: the dots are buttons too, and this rule's padding
  // would stretch each one into a bar.
  > button
    background panel
    color ink
    border 1px solid line
    border-radius 4px
    padding 3px 12px
    cursor pointer
    &:hover
      background #333846
    &:disabled
      color #4d5261
      cursor default
      &:hover
        background panel

// Dots take the whole first row (a thirty-step tour would otherwise crowd the
// buttons off the balloon) and double as jump targets.
.tour-dots
  flex 0 0 100%
  display flex
  flex-wrap wrap
  gap 4px
  margin-bottom 2px

.tour-back
  margin-left auto

.tour-dot
  width 7px
  height 7px
  padding 0
  border-radius 50%
  border 1px solid line
  background transparent
  cursor pointer
  &[data-done="1"]
    background inkDim
    border-color inkDim
  &[data-cur="1"]
    background amber
    border-color amber

button
  font inherit
